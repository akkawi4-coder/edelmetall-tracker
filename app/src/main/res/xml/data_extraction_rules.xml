<?xml version="1.0" encoding="utf-8"?>
<!-- Keine Cloud-Sicherung und keine Geräteübertragung: alle Daten bleiben verschlüsselt auf diesem Gerät.
     Sicherungen macht der Nutzer selbst über das verschlüsselte Backup in den Einstellungen. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
